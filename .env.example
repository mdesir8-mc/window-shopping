VITE_API_BASE_URL="http://localhost:3000"
VITE_GOOGLE_CLIENT_ID="your-google-oauth-web-client-id.apps.googleusercontent.com"

# Transactional email (Resend). Leave RESEND_API_KEY blank to disable sending in
# dev/CI — sendEmail() then logs instead of delivering. The onboarding@resend.dev
# sender works without domain verification for early testing.
RESEND_API_KEY=""
EMAIL_FROM="Window Shopping <onboarding@resend.dev>"
# Also the OAuth issuer and MCP resource identifier: the MCP server advertises
# "${APP_BASE_URL}/mcp" as its canonical URL, which must match what users type
# into Claude when adding the connector.
APP_BASE_URL="http://localhost:5173"

# Signs MCP access tokens. Must differ from the server's JWT_SECRET.
MCP_JWT_SECRET="replace-with-a-different-random-secret"

# Shared secret for the daily refresh trigger (POST /api/cron/refresh), called by the
# GitHub Action in .github/workflows/refresh-cron.yml. Leave blank to disable the
# endpoint (it returns 503). Use a long random value in production.
CRON_SECRET=""
