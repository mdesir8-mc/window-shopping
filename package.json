{
  "name": "window-shopping",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "ci": "npm run typecheck && npm run build && npm --prefix server test && npm --prefix server run build",
    "prepare": "husky",
