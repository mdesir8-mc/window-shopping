DATABASE_URL="postgresql://user:password@localhost:5432/window_shopping"
TEST_DATABASE_URL="postgresql://user:password@localhost:5432/window_shopping_test"
JWT_SECRET="replace-with-random-secret"
GOOGLE_CLIENT_ID="your-google-oauth-web-client-id.apps.googleusercontent.com"
GOOGLE_IOS_CLIENT_ID="your-google-oauth-ios-client-id.apps.googleusercontent.com"
PORT=3000
FRONTEND_ORIGIN="http://localhost:3000"
# Shared secret for the daily refresh trigger (POST /api/cron/refresh). Leave blank to
# disable the endpoint (returns 503). Set a long random value in production.
CRON_SECRET=""

# Unblocker tier for bot-walled retailers (The RealReal, Nordstrom).
# Set both to enable. UNBLOCKER_DAILY_CAP defaults to 100 requests/day.
# Reference adapter: ScrapingBee — https://www.scrapingbee.com/documentation/
UNBLOCKER_API_URL="https://app.scrapingbee.com/api/v1/"
UNBLOCKER_API_KEY=""
UNBLOCKER_DAILY_CAP="100"
