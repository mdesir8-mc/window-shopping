# Copy to mobile/.env. EXPO_PUBLIC_* vars are inlined into the JS bundle at build time.
# Prod: the Railway API URL. Dev: the iOS simulator can reach localhost:<port>;
# a physical iPhone needs your Mac's LAN IP (or a tunnel). Server defaults to :3000.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000

# iOS OAuth client ID from Google Cloud Console (Phase 5). Leave blank until created.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
